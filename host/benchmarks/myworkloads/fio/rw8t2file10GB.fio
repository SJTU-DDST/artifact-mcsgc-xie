[global]
ioengine=libaio
direct=1
bs=4K
iodepth=32
thread
group_reporting 
;directory=/mnt/openssd_f2fs

;size=20G
;filesize=60G

[g1]
rw=randwrite
numjobs=4
filename=/home/xin/ssd/mnt/g1.dat
filesize=14G
size=10G

[g2]
new_group
rw=randwrite
numjobs=4
filename=/home/xin/ssd/mnt/g2.dat
filesize=14G
size=10G

[g3]
new_group
rw=randwrite
numjobs=4
filename=/home/xin/ssd/mnt/g3.dat
filesize=14G
size=10G


[g4]
new_group
rw=randwrite
numjobs=4
filename=/home/xin/ssd/mnt/g4.dat
filesize=14G
size=10G

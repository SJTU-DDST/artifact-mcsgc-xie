[global]
ioengine=libaio
bs=64K
group_reporting 
;directory=/mnt/openssd_f2fs
openfiles=1
nrfiles=1
;size=20G
;filesize=60G
filename=testbigfile1

[randwrite]
openfiles=1
nrfiles=1

;time_based=1
;runtime=300
direct=0
readwrite=randwrite
;numjobs=4
thread
clocksource=cpu
file_service_type=random
;random_distribution=${random_distribution}
;random_distribution=zoned:60/40:40/60
;random_distribution=zoned:60/30:40/70
;random_distribution=zoned:60/20:40/80



;filesize=1M
;nrfiles=60000